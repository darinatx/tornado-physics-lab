{
  "name": "tornado-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "trace": "tsx scripts/check-trace.ts",
    "verify": "npm run typecheck && npm run test && npm run trace",
    "verify:fast": "npm run typecheck && npm run test:fast && npm run trace",
    "test:fast": "vitest run tests/unit",
    "check:passthrough": "tsx scripts/check-passthrough.ts",
    "check:alignment": "tsx scripts/check-alignment.ts",
    "tunnel": "tsx scripts/tunnel.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-simd-compat": "^0.19.3",
    "lil-gui": "^0.20.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/three": "^0.170.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
